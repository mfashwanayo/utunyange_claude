<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-col footer-about">
      <a class="brand brand-light" href="/">
        <span class="brand-mark">U</span>
        <span class="brand-text"><strong><%= school.name %></strong><small>School</small></span>
      </a>
      <p><%= school.tagline %>. A community where every learner is known, challenged and supported to succeed.</p>
      <div class="footer-social">
        <a href="<%= school.social.facebook %>" aria-label="Facebook"><svg class="icon"><use href="#i-facebook"/></svg></a>
        <a href="<%= school.social.instagram %>" aria-label="Instagram"><svg class="icon"><use href="#i-instagram"/></svg></a>
        <a href="<%= school.social.twitter %>" aria-label="Twitter"><svg class="icon"><use href="#i-twitter"/></svg></a>
        <a href="<%= school.social.youtube %>" aria-label="YouTube"><svg class="icon"><use href="#i-youtube"/></svg></a>
      </div>
    </div>

    <div class="footer-col">
      <h4>Quick links</h4>
      <ul>
        <li><a href="/#about">About us</a></li>
        <li><a href="/#academics">Academics</a></li>
        <li><a href="/#admissions">Admissions</a></li>
        <li><a href="/#news">News &amp; events</a></li>
        <li><a href="/#gallery">Gallery</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Portals</h4>
      <ul>
        <li><a href="/auth/login?role=student">Student portal</a></li>
        <li><a href="/auth/login?role=parent">Parent portal</a></li>
        <li><a href="/auth/login?role=teacher">Teacher portal</a></li>
        <li><a href="/auth/login?role=admin">Staff &amp; admin</a></li>
      </ul>
    </div>

    <div class="footer-col">
      <h4>Contact</h4>
      <ul class="footer-contact">
        <li><svg class="icon"><use href="#i-map-pin"/></svg><span><%= school.address %></span></li>
        <li><svg class="icon"><use href="#i-phone"/></svg><span><%= school.phone %></span></li>
        <li><svg class="icon"><use href="#i-mail"/></svg><span><%= school.email %></span></li>
        <li><svg class="icon"><use href="#i-clock"/></svg><span><%= school.hours %></span></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; <%= year %> <%= school.fullName %>. All rights reserved.</p>
      <p><%= school.motto %></p>
    </div>
  </div>
</footer>
