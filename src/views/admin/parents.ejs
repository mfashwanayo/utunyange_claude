<%- include('../partials/page-head', { ph: { title: 'Parents & guardians', subtitle: pager.total + ' parent(s)', actions: [{ href: '/admin/parents/new', label: 'Add parent', icon: 'plus' }] } }) %>

<form class="filters" method="get" action="/admin/parents">
  <input type="search" name="q" value="<%= filters.q %>" placeholder="Search name, email or phone">
  <select name="status" aria-label="Status">
    <option value="">Any status</option>
    <% ['active', 'inactive', 'suspended'].forEach(function (s) { %><option value="<%= s %>"<%= filters.status === s ? ' selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option><% }) %>
  </select>
  <button class="btn btn-primary btn-sm" type="submit">Filter</button>
  <% if (filters.q || filters.status) { %><a class="btn btn-ghost-dark btn-sm" href="/admin/parents">Clear</a><% } %>
</form>

<section class="card card-flush">
  <% if (rows.length) { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Parent</th><th>Phone</th><th>Children</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% rows.forEach(function (r) { %>
            <tr>
              <td><span class="cell-main"><%= r.first_name %> <%= r.last_name %></span><span class="cell-sub"><%= r.email %></span></td>
              <td><%= r.phone || '-' %></td>
              <td><%= r.children || 'None linked yet' %></td>
              <td><span class="badge badge-<%= r.status === 'active' ? 'green' : (r.status === 'suspended' ? 'red' : 'gray') %>"><%= r.status %></span></td>
              <td class="actions">
                <a class="btn btn-soft btn-xs" href="/admin/parents/<%= r.id %>/edit"><svg class="icon"><use href="#i-edit"/></svg>Edit</a>
                <form method="post" action="/admin/parents/<%= r.id %>/reset-password" data-confirm="Create a new temporary password for <%= r.first_name %> <%= r.last_name %>?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                  <button class="btn btn-soft btn-xs" type="submit"><svg class="icon"><use href="#i-key"/></svg>Reset password</button>
                </form>
                <form method="post" action="/admin/parents/<%= r.id %>/status" data-confirm="<%= r.status === 'active' ? 'Deactivate' : 'Activate' %> <%= r.first_name %> <%= r.last_name %>?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                  <button class="btn <%= r.status === 'active' ? 'btn-danger' : 'btn-soft' %> btn-xs" type="submit"><svg class="icon"><use href="#i-power"/></svg><%= r.status === 'active' ? 'Deactivate' : 'Activate' %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty"><svg class="icon"><use href="#i-users"/></svg><strong>No parents found</strong>Add a parent, then link them to their children from the student page.</div>
  <% } %>
</section>

<%- include('../partials/pagination') %>
