<%- include('../partials/page-head', { ph: { title: 'Students', subtitle: pager.total + ' student(s)' + (year ? ' - classes shown for ' + year.name : ''), actions: [{ href: '/admin/students/new', label: 'Add student', icon: 'plus' }] } }) %>

<form class="filters" method="get" action="/admin/students">
  <input type="search" name="q" value="<%= filters.q %>" placeholder="Search name or admission number">
  <select name="class_id" aria-label="Class">
    <option value="">All classes</option>
    <% classOptions.forEach(function (o) { %><option value="<%= o.value %>"<%= String(filters.class_id) === String(o.value) ? ' selected' : '' %>><%= o.label %></option><% }) %>
  </select>
  <select name="status" aria-label="Status">
    <option value="">Any status</option>
    <% statusOptions.forEach(function (o) { %><option value="<%= o.value %>"<%= filters.status === o.value ? ' selected' : '' %>><%= o.label %></option><% }) %>
  </select>
  <button class="btn btn-primary btn-sm" type="submit">Filter</button>
  <% if (filters.q || filters.class_id || filters.status) { %><a class="btn btn-ghost-dark btn-sm" href="/admin/students">Clear</a><% } %>
</form>

<section class="card card-flush">
  <% if (rows.length) { %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Admission no.</th><th>Student</th><th>Gender</th><th>Class</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% rows.forEach(function (r) { %>
            <tr>
              <td><%= r.admission_no %></td>
              <td><a class="cell-main" href="/admin/students/<%= r.id %>"><%= r.first_name %> <%= r.last_name %></a></td>
              <td><%= r.gender === 'male' ? 'Male' : 'Female' %></td>
              <td><%= r.class_name ? classLabel(r.class_name, r.class_section) : '-' %></td>
              <td><span class="badge badge-<%= r.status === 'active' ? 'green' : (r.status === 'graduated' ? 'blue' : 'gray') %>"><%= r.status %></span></td>
              <td class="actions">
                <a class="btn btn-soft btn-xs" href="/admin/students/<%= r.id %>">View</a>
                <a class="btn btn-soft btn-xs" href="/admin/students/<%= r.id %>/edit"><svg class="icon"><use href="#i-edit"/></svg>Edit</a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <div class="empty"><svg class="icon"><use href="#i-graduation"/></svg><strong>No students found</strong>Add your first student, or try a different search.</div>
  <% } %>
</section>

<%- include('../partials/pagination') %>
